#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 FragColor [[color(0)]];
};

struct main0_in
{
    float2 v_uv [[user(locn0)]];
    float4 v_color [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> spriteTexture [[texture(0)]], sampler spriteTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.FragColor = spriteTexture.sample(spriteTextureSmplr, in.v_uv) * in.v_color;
    return out;
}


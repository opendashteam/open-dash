#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 v_fragColor [[color(0)]];
};

struct main0_in
{
    float4 v_color [[user(locn0)]];
    float2 v_texCoord [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> meshTexture [[texture(0)]], sampler meshTextureSmplr [[sampler(0)]])
{
    main0_out out = {};
    out.v_fragColor = meshTexture.sample(meshTextureSmplr, in.v_texCoord) * in.v_color;
    return out;
}

